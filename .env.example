NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opt-in ONLY after a dedicated public Worker and read-only Neon role have passed
# live staging security tests. By default both website adapters use empty verified
# local read models; never quietly substitute mock data when remote is enabled.
# FBMN_PUBLIC_API_ENABLED=false
# FBMN_PUBLIC_API_BASE_URL=https://your-reviewed-public-worker.example.com
# Server-only: DO NOT prefix public API base URL, Neon, Hyperdrive, R2 keys with NEXT_PUBLIC_.
# Public, vetted HTTPS custom domain for APPROVED R2 images only. Leave blank until configured.
# NEXT_PUBLIC_MEDIA_BASE_URL=https://assets.your-approved-domain.example

# ADM-01 Admin login preview (server-only, preview target; never set in client public env)
# NEON_AUTH_BASE_URL=https://your-neon-auth-staging.neon.tech/neondb/auth
# NEON_AUTH_COOKIE_SECRET=generate-new-random-secret-at-least-32-chars
# FBMN_ADMIN_API_BASE_URL=https://your-dedicated-admin-worker-staging.workers.dev/


# DL6 Outsourcing: OFF until reviewed Neon migration, private Owner inbox,
# rate binding and an approved real receiving workflow have passed UAT.
# Public Next server gate (no NEXT_PUBLIC_); not a Vercel client variable.
# FBMN_DL6_ENABLED=false
# Cloudflare Public Worker must independently set PUBLIC_DL6_ENABLED=true
# and OUTSOURCING_RATE_LIMITER (4 requests per 60 seconds per Cloudflare client IP).
# Allowed site origins must include the verified fbmn.vn and fbmn.com.vn aliases.
