// ADM-01 #11 — staging Worker only. Bound to RESTRICTED Neon staging role,
// never production/public Hyperdrive. API token verification remains fail-closed;
// issuer is the Auth HOST ORIGIN per Neon Functions authentication guide;
// NEON_AUTH_AUDIENCE is the branch Auth URL used to PIN the JWKS location;
// it is NOT an assumed JWT aud claim. Neon Managed JWT verifier requires
// signature + issuer + expiry, not a fabricated branch URL audience.
// Verify real logged-in Owner E2E before marking ADM-01 complete.
{
  "name": "futurebook-mien-nam-admin-api-staging",
  "main": "./worker-entry.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {"crons": ["*/5 * * * *"]},
  "vars": {
    "EXPECTED_ADMIN_DB_ROLE": "fbmn_admin_http_staging",
    "ADMIN_CMS_PUBLIC_READY": "true",
    "ADMIN_ALLOWED_ORIGINS": "https://fbmn-admin-g19nfukpu-alibaba240185.vercel.app,https://fbmn-admin.vercel.app",
    "NEON_AUTH_JWKS_URL": "https://ep-old-moon-b5lq2yse.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json",
    "NEON_AUTH_ISSUER": "https://ep-old-moon-b5lq2yse.neonauth.c-7.us-east-2.aws.neon.tech",
    "NEON_AUTH_AUDIENCE": "https://ep-old-moon-b5lq2yse.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"
  },
  "r2_buckets": [
    {"binding":"CHATBOT_CREDENTIALS_R2","bucket_name":"fbmn-chatbot-credentials"},
    {"binding":"ADMIN_MEDIA_R2","bucket_name":"fbmn"},
    {"binding":"CATALOGUE_MEDIA_R2","bucket_name":"fbmn-catalogue"}
  ],
  "hyperdrive": [
    {
      "binding": "ADMIN_HYPERDRIVE",
      "id": "fb85a0f952de42f4a21cd8e3c7a9bf8b"
    }
  ],
  "ratelimits": [
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "20261030",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
