{
  "name": "futurebook-mien-nam-public-api-staging",
  "main": "./worker-entry.mjs",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "vars": {
    "PUBLIC_ALLOWED_ORIGINS": "https://fbmn-web.vercel.app,https://fbmn.vn,https://www.fbmn.vn,https://fbmn.com.vn,https://www.fbmn.com.vn",
    "EXPECTED_DB_ROLE": "fbmn_p5_public_login",
    "PUBLIC_P5_ENABLED": "true",
    "PUBLIC_CMS_ENABLED": "true",
    "PUBLIC_DL4_ENABLED": "true",
    "PUBLIC_DL7C_ENABLED": "true",
    "PUBLIC_DL7A_PDF_ENABLED": "false",
    "PUBLIC_DL6_ENABLED": "false"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "a41b7ba00cbe4bf6b6485dee613f0a77"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PUBLIC_MEDIA_R2",
      "bucket_name": "fbmn"
    },
    {
      "binding": "CATALOGUE_MEDIA_R2",
      "bucket_name": "fbmn-catalogue"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "20261029",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "OUTSOURCING_RATE_LIMITER",
      "namespace_id": "20261110",
      "simple": { "limit": 4, "period": 60 }
    },
    {
      "name": "IMAGE_RATE_LIMITER",
      "namespace_id": "20261102",
      "simple": {
        "limit": 1000,
        "period": 60
      }
    }
  ]
}
