{
  "openapi": "3.1.0",
  "info": {
    "title": "Futurebook Miền Nam — Public Read API",
    "version": "1.0.0",
    "description": "Read-only approved catalogue/content. Never exposes NET/dealer/contract prices, customers, orders or approval metadata. This document is a staging contract, not a deployed service."
  },
  "servers": [
    {
      "url": "https://api.example.invalid",
      "description": "Placeholder; replace only with reviewed Workers public hostname"
    }
  ],
  "paths": {
    "/v1/public/categories": {
      "get": {
        "operationId": "listPublicCategories",
        "description": "Published categories only",
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Category"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/public/products": {
      "get": {
        "operationId": "listPublicProducts",
        "description": "Approved public products only; optional exact slug lookup; server consumers may request up to 1000 approved products per page.",
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Products with pagination",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "pagination"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    },
    "/v1/public/content": {
      "get": {
        "operationId": "getPublicContent",
        "description": "Approved live editorial content only",
        "responses": {
          "200": {
            "description": "Content",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Content"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "name",
          "group",
          "sortOrder"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "enum": [
              "school_notebook",
              "student_notebook",
              "memo_book",
              "stationery"
            ]
          },
          "sortOrder": {
            "type": "integer"
          }
        }
      },
      "Price": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "retail"
          },
          "amountVnd": {
            "type": "integer",
            "minimum": 0
          },
          "currency": {
            "const": "VND"
          }
        },
        "required": [
          "kind",
          "amountVnd",
          "currency"
        ]
      },
      "Variant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sku",
          "name",
          "specifications",
          "price"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "specifications": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "paperSize": {
                "type": "string"
              },
              "pageCount": {
                "type": "integer"
              },
              "paperWeightGsm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "binding": {
                "type": "string"
              },
              "coverFinish": {
                "type": "string"
              },
              "packaging": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "saleUnit": {
                    "type": "string"
                  },
                  "unitsPerPack": {
                    "type": "integer"
                  },
                  "unitsPerCarton": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          }
        }
      },
      "Media": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "r2Key",
          "alt",
          "position"
        ],
        "properties": {
          "r2Key": {
            "type": "string"
          },
          "alt": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          }
        }
      },
      "Product": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "categoryId",
          "name",
          "slug",
          "priceLabel",
          "variants",
          "media"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "categoryId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priceLabel": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Liên hệ báo giá",
              null
            ]
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Variant"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Media"
            }
          }
        }
      },
      "Pagination": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ],
        "properties": {
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "Content": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "company",
          "articles",
          "promotions",
          "dealerInformation"
        ],
        "properties": {
          "company": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "legalName": {
                "type": "string"
              },
              "address": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "hours": {
                "type": "string"
              }
            }
          },
          "articles": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slug",
                "title",
                "summary",
                "paragraphs",
                "publishedAt"
              ],
              "properties": {
                "slug": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "paragraphs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "publishedAt": {
                  "type": "string"
                }
              }
            }
          },
          "promotions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "slug",
                "title",
                "summary",
                "detail",
                "endsAt"
              ],
              "properties": {
                "slug": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "endsAt": {
                  "type": "string"
                }
              }
            }
          },
          "dealerInformation": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "paragraphs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "contactInstructions": {
                "type": "string"
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid query",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Route or requested slug not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Read model unavailable, fail closed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
