# Preview-only secrets; NEVER prefix with NEXT_PUBLIC_.
# NEON_AUTH_BASE_URL=https://your-neon-auth-staging.example/neondb/auth
# NEON_AUTH_COOKIE_SECRET=unique-cryptographic-random-secret-at-least-32-characters
# FBMN_ADMIN_API_BASE_URL=https://your-restricted-admin-api-staging.workers.dev/

# L04 PostHog: OFF by default. Configure both explicit switches + project key
# in the Vercel Admin project (server-side key must NEVER use NEXT_PUBLIC_).
# NEXT_PUBLIC_FBMN_ADMIN_TELEMETRY=1
# FBMN_ADMIN_POSTHOG_ENABLED=1
# FBMN_ADMIN_POSTHOG_PROJECT_KEY=phc_your_posthog_project_key
# FBMN_ADMIN_POSTHOG_HOST=https://us.i.posthog.com
