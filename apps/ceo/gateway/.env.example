# DL12D: use the SAME Neon Auth configuration as the approved Admin, but
# maintain a distinct CEO application cookie scope (same-origin only).
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
FBMN_ADMIN_API_BASE_URL=
# Published public catalogue Worker (separate from the Admin Worker); server-only HTTPS origin.
FBMN_CEO_PUBLIC_API_BASE_URL=

# DL12C — do not populate with your Admin DB owner credentials.
# Dedicated least-privilege Neon role fbmn_ceo_push_login, created separately.
FBMN_CEO_PUSH_DATABASE_URL=
# Generate one VAPID keypair; never store the private key in Git.
FBMN_CEO_VAPID_PUBLIC_KEY=
FBMN_CEO_VAPID_PRIVATE_KEY=
# 32+ character random secret; MUST match Cloudflare Worker secret
# FBMN_CEO_PUSH_DISPATCH_SECRET. Never expose to Flutter/browser.
CRON_SECRET=

# CEO-MAIL01: Resend server-only key; configure as encrypted Vercel project secret.
RESEND_API_KEY=

# CEO-MAIL02: configured only after signed webhook rollout
RESEND_WEBHOOK_SECRET=

# DL12B: US PostHog project 732495. Server-only, encrypted personal API key.
FBMN_CEO_POSTHOG_PERSONAL_API_KEY=


# SEO06 OAuth — no service-account JSON is needed.
# The value must match the verified Search Console property (Domain or URL-prefix).
FBMN_CEO_GSC_SITE_URL=sc-domain:fbmn.vn
# Google Cloud > Google Auth Platform > Clients > OAuth Client ID > Web application.
# Authorized redirect URI: https://ceo.fbmn.vn/api/ceo/gsc/oauth/callback
FBMN_CEO_GSC_OAUTH_CLIENT_ID=
FBMN_CEO_GSC_OAUTH_CLIENT_SECRET=
# Generate a 32-byte random key, 64 lowercase hexadecimal chars. Store encrypted in Vercel Production.
FBMN_CEO_GSC_OAUTH_ENCRYPTION_KEY=
# Reuses the existing FBMN_CEO_PUSH_DATABASE_URL for encrypted token storage.
# Apply backend/neon/migrations/20261114_seo06_gsc_oauth.up.sql only after Owner approves.
